#!/usr/bin/env bash
# The installed engine. `install-engine.sh` symlinks this into ~/.local/bin; it runs the
# package straight from the checkout, so `git pull` there is the whole upgrade — and the
# repo's kit.json pin decides whether that upgrade is accepted (`ckit check` fails loud).
set -euo pipefail
self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "$self")/.." && pwd)"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m ckit "$@"
